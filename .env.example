# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas (Database → Connect → Drivers)
# Server only — never expose to the browser (PRD F18)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.jiloy9j.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=attaqwa

# Public site URL, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Madrasatut Taqwa website (PRD §1.3, open question #3)
NEXT_PUBLIC_MADRASATUT_TAQWA_URL=

# Express API base URL, called server-side by the AI chat assistant (/api/chat)
API_URL=http://localhost:5000/api/v1
# Same API, called from the browser for login, enrollment and TrxID re-submit (cookie auth, credentials: "include")
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# AI chat assistant (ai-chat-prompts.md §B). Server only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5-5

# Later phases
# RESEND_API_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
