# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000
# Reverse proxies in front of the API: 0 = direct, 1 = behind one load balancer / Nginx.
# Wrong value = spoofable rate limits (too high) or all users sharing one IP (too low).
TRUST_PROXY=0

# MongoDB Atlas — must be a replica set (transactions)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=attaqwa

# Next.js frontend origin (CORS, credentials: true)
FRONTEND_URL=http://localhost:3000

# JWT for the accessToken cookie — at least 32 random characters
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_EXPIRES_IN_SECONDS=604800
# Production: .attaqwainstitute.com (lets the Next.js server read the cookie). Leave empty locally.
COOKIE_DOMAIN=

# HMAC key for OTP hashes — at least 32 random characters, different from JWT_SECRET
OTP_SECRET=change-me-to-another-long-random-string

# Resend — required in production. Without it (dev only) emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=At-Taqwa Institute <no-reply@attaqwainstitute.com>

# Merchant numbers shown on course detail (api-spec §5.2 paymentInfo)
BKASH_MERCHANT_NUMBER=
NAGAD_MERCHANT_NUMBER=

# Cloudflare R2 — image / video / PDF uploads (api-spec §12). Without all five, uploads answer 503.
# The bucket needs a CORS rule allowing PUT from FRONTEND_URL (videos upload straight from the browser).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN base for the bucket (custom domain or r2.dev URL), no trailing slash
R2_PUBLIC_URL=https://cdn.attaqwainstitute.com
